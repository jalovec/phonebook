<div class="row align-items-center">
    <div class="col-md-6">
        {% if contacts is defined %}
        <div class="mb-3">
            <h5 class="card-title">{{ 'CONTACTS_LIST'|trans }} <span class="text-muted fw-normal ms-2">({{ contactsCount  }})</span></h5>
        </div>
        {% endif %}
    </div>
    <div class="col-md-6">
        <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-3">
            <div>
                <a href="{{ path('create_route') }}" class="btn btn-primary"><i class="bx bx-plus me-1"></i>{{ 'ADD_CONTACT'|trans }}</a>
            </div>
        </div>
    </div>
</div>